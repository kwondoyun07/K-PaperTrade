# Turso — 서버 전용. NEXT_PUBLIC_ 접두사 절대 금지.
TURSO_KRX_MARKET_URL=libsql://krx-market-<org>.turso.io
TURSO_KRX_MARKET_AUTH_TOKEN=
TURSO_TRADING_URL=libsql://trading-<org>.turso.io
TURSO_TRADING_AUTH_TOKEN=

# 인증 — Google 로그인(Auth.js). AUTH_GOOGLE_ID가 비면 로컬 개발 모드(인증 생략).
# ALLOWED_EMAILS가 비면 아무도 로그인 못 한다(fail-closed) — 배포 시 반드시 채울 것.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=you@gmail.com

# 분봉 parquet Release 소스 (배포 시). 로컬은 collector/data/minute 우선.
GITHUB_REPO=kwondoyun07/K-PaperTrade
# 비공개 저장소면 필수 — contents:read 스코프 PAT (공개면 생략 가능)
GITHUB_RELEASE_TOKEN=

# 키움 REST API — 모의투자 전용(실전 키 금지). 없으면 네이버로 폴백(과거 백필 불가).
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_HOST=https://mockapi.kiwoom.com

# 체결 엔진 config (3단계에서 사용)
SLIPPAGE_BP=5
COMMISSION_RATE=0.00015
# 증권거래세+농특세 합산 0.15% (2026-08 기준, 세율 변동 시 수정)
SELL_TAX_RATE=0.0015
